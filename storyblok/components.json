        "answer": {
          "type": "richtext",
          "pos": 1,
          "required": true,
          "translatable": true,
          "description": "The answer, revealed when the item is expanded. Supports links and formatting."
        }
      },
      "color": "#6B7C8F",
      "icon": "block-comment"
    },
    {
      "name": "faq_category",
      "display_name": "FAQ Category",
      "is_root": false,
      "is_nestable": true,
      "real_name": "faq_category",
      "schema": {
        "title": {
          "type": "text",
          "pos": 0,
          "required": true,
          "translatable": true,
          "description": "Section heading grouping a set of FAQ items (e.g. \"Account & Plans\")."
