      "display_name": "FAQ Item",
      "is_root": false,
      "is_nestable": true,
      "real_name": "faq_item",
      "schema": {
        "question": {
          "type": "text",
          "pos": 0,
          "required": true,
          "translatable": true,
          "description": "The question, shown as the accordion header."
