          "description": "Author name. Optional."
        },
        "published_date": {
          "type": "datetime",
          "pos": 6,
          "required": true,
          "description": "Publication date used for sorting and display."
        },
        "read_time": {
          "type": "text",
          "pos": 7,
          "required": true,
          "description": "Display string like \"8 min read\"."
        },
        "tab_meta": {
          "type": "tab",
          "pos": 8,
          "display_name": "Metadata",
          "keys": ["author", "published_date", "read_time"]
        },
        "body": {
          "type": "richtext",
          "pos": 9,
          "required": true,
          "translatable": true,
          "description": "Main article body. Use headings, paragraphs, bullet lists."
        },
        "feature_title": {
          "type": "text",
          "pos": 15,
          "translatable": true,
          "description": "Optional heading for the highlighted feature callout (styled like the \"Why Emporva?\" card — white with a gold left border)."
        },
        "feature": {
          "type": "richtext",
          "pos": 16,
          "translatable": true,
          "description": "Optional feature / information callout rendered in a white card with a gold left border. Leave empty to hide."
        },
        "tab_content": {
          "type": "tab",
          "pos": 10,
          "display_name": "Content",
          "keys": ["body", "feature_title", "feature"]
        },
        "seo_title": {
          "type": "text",
          "pos": 11,
          "translatable": true
        },
        "seo_description": {
          "type": "textarea",
          "pos": 12,
          "translatable": true
        },
        "keywords": {
          "type": "text",
          "pos": 13,
          "translatable": true,
          "description": "Comma-separated SEO keywords."
        },
        "tab_seo": {
          "type": "tab",
          "pos": 14,
          "display_name": "SEO",
          "keys": ["seo_title", "seo_description", "keywords"]
        }
      },
      "color": "#0B1F33",
      "icon": "block-text"
    },
