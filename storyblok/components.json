{
  "components": [
    {
      "name": "service",
      "display_name": "Service",
      "is_root": true,
      "is_nestable": false,
      "real_name": "service",
      "schema": {
        "title": {
          "type": "text",
          "pos": 0,
          "required": true,
          "translatable": true,
          "description": "Service title shown in the hero (e.g. \"Plumbing Repair Services\")."
        },
        "description": {
          "type": "textarea",
          "pos": 1,
          "required": true,
          "translatable": true,
          "description": "Short subtitle shown under the hero title."
        },
        "icon": {
          "type": "text",
          "pos": 2,
          "required": true,
          "description": "Remix icon class (e.g. \"ri-drop-line\")."
        },
        "hero_image": {
          "type": "asset",
          "filetypes": ["images"],
          "pos": 3,
          "required": true,
          "description": "Background image for the service hero."
        },
        "tab_overview": {
          "type": "tab",
          "pos": 4,
          "display_name": "Overview",
          "keys": ["title", "description", "icon", "hero_image"]
        },
        "common_issues": {
          "type": "bloks",
          "pos": 5,
          "restrict_components": true,
          "component_whitelist": ["bullet"],
          "minimum": "1",
          "description": "Bulleted list of common issues this service resolves."
        },
        "process_steps": {
          "type": "bloks",
          "pos": 6,
          "restrict_components": true,
          "component_whitelist": ["bullet"],
          "minimum": "1",
          "description": "Ordered steps shown in the \"How Emporva Works\" section."
        },
        "feature_title": {
          "type": "text",
          "pos": 16,
          "translatable": true,
          "description": "Optional heading for the highlighted feature callout (styled like the \"Why Emporva?\" card — white with a gold left border)."
        },
        "feature": {
          "type": "richtext",
          "pos": 17,
          "translatable": true,
          "description": "Optional feature / information callout rendered in a white card with a gold left border. Leave empty to hide."
        },
        "tab_content": {
          "type": "tab",
          "pos": 7,
          "display_name": "Content",
          "keys": ["common_issues", "process_steps", "feature_title", "feature"]
        },
        "avg_cost": {
          "type": "text",
          "pos": 8,
          "required": true,
          "description": "Typical cost range (e.g. \"$150 - $500\")."
        },
        "urgency": {
          "type": "text",
          "pos": 9,
          "required": true,
          "description": "Urgency / response time copy (e.g. \"Often requires same-day service\")."
        },
        "body": {
          "type": "richtext",
          "pos": 10,
          "translatable": true,
          "description": "Optional long-form body content rendered below the standard sections."
        },
        "tab_details": {
          "type": "tab",
          "pos": 11,
          "display_name": "Details",
          "keys": ["avg_cost", "urgency", "body"]
        },
        "seo_title": {
          "type": "text",
          "pos": 12,
          "translatable": true
        },
        "seo_description": {
          "type": "textarea",
          "pos": 13,
          "translatable": true
        },
        "keywords": {
          "type": "text",
          "pos": 14,
          "translatable": true,
          "description": "Comma-separated SEO keywords."
        },
        "tab_seo": {
          "type": "tab",
          "pos": 15,
          "display_name": "SEO",
          "keys": ["seo_title", "seo_description", "keywords"]
        }
      },
      "color": "#0B1F33",
      "icon": "block-wrench"
    },
    {
      "name": "services_index",
