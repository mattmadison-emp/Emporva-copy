        "subhead": {
          "type": "textarea",
          "pos": 1,
          "translatable": true,
          "description": "Hero subhead / intro paragraph."
        },
        "body": {
          "type": "richtext",
          "pos": 2,
          "translatable": true,
          "description": "Optional rich-text content rendered below the service grid."
        },
        "seo_title": {
          "type": "text",
          "pos": 3,
          "translatable": true
        },
        "seo_description": {
          "type": "textarea",
          "pos": 4,
          "translatable": true
        }
      },
      "color": "#0B1F33",
      "icon": "block-grid"
    },
